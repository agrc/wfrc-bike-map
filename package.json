{
  "name": "wfrc-bike-map",
  "version": "1.1.9",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc -b",
    "copy:arcgis": "cpy \"./node_modules/@arcgis/core/assets/**\" ./public/assets",
    "dev:firebase-emulators": "./scripts/start-emulators.sh",
    "dev:vite": "vite",
    "download-configs:dev": "pnpm exec firebase remoteconfig:get -o src/remote_config_defaults.json --project ut-dts-agrc-wfrc-bike-map-dev",
    "download-configs:prod": "pnpm exec firebase remoteconfig:get -o src/remote_config_defaults.json --project ut-dts-agrc-wfrc-bike-map-prod",
    "format": "prettier . --write",
    "postinstall": "pnpm run copy:arcgis",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "concurrently 'cd functions && pnpm run build:watch' 'wait-on http://127.0.0.1:4000 && pnpm run dev:vite' 'pnpm run dev:firebase-emulators'",
    "test": "vitest"
  },
  "browserslist": {
    "production": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@arcgis/core": "^5.1.27",
    "@arcgis/map-components": "^5.1.27",
    "@esri/arcgis-rest-request": "^4.11.0",
    "@esri/calcite-components": "^5.2.0",
    "@tanstack/react-query": "^5.105.3",
    "@ugrc/esri-theme-toggle": "^2.0.1",
    "@ugrc/utah-design-system": "^4.3.2",
    "@ugrc/utilities": "^5.0.1",
    "concurrently": "^10.0.6",
    "firebase": "^13.2.0",
    "immer": "^11.2.9",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-aria": "~3.53.1",
    "react-aria-components": "~1.22.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-stately": "~3.51.0",
    "tailwind-merge": "^3.7.0",
    "use-immer": "^0.11.0",
    "usehooks-ts": "^3.1.1",
    "wait-on": "^9.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@ugrc/eslint-config": "^1.3.1",
    "@ugrc/tailwind-preset": "^2.0.1",
    "@ugrc/tsconfigs": "^1.0.4",
    "@vitejs/plugin-react": "^6.2.1",
    "cpy-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "firebase-tools": "^15.34.2",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-package-version": "^1.1.0",
    "vitest": "^5.1.0"
  }
}
